# ---------------------------------------------------------------------------
# TKEP2.0 (World Wipe) environment
# Copy to `.env.local` for local dev (`cp .env.example .env.local`).
# Only NEXT_PUBLIC_* values are needed by the app; they are exposed to the
# browser, so never put secrets (service_role key, DB password) here.
# ---------------------------------------------------------------------------

# Base URL of your Supabase API gateway.
#   - Supabase CLI (`supabase start`):  http://127.0.0.1:54321
#   - Self-hosted Docker Compose:       http://<host>:8000
#   - Supabase cloud:                   https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key for the above project.
# The value below is the WELL-KNOWN local demo key that the Supabase CLI and
# the default self-hosting compose use. It is safe only for local development.
# Regenerate a fresh anon key (and JWT secret) before exposing the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# ---------------------------------------------------------------------------
# Single-origin mode (recommended when exposing via one Tailscale Funnel port).
# When enabled, the browser calls Supabase through the app's OWN origin and the
# Next.js server proxies the requests to Supabase — so only the app port needs
# to be public, and there is no CORS to configure.
# ---------------------------------------------------------------------------

# Browser: use the current page origin as the Supabase URL instead of
# NEXT_PUBLIC_SUPABASE_URL. Leave unset (or "false") for direct/cloud mode.
# NEXT_PUBLIC_SUPABASE_SAME_ORIGIN=true

# Server-only: where the app forwards /auth/v1, /rest/v1, etc. Point this at the
# Supabase gateway reachable from the app process (e.g. the CLI stack, or the
# self-hosting Kong gateway). Evaluated at BUILD time (see Dockerfile build arg).
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
